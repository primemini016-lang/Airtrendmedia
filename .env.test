APP_NAME=MiniWorkers
APP_ENV=production
APP_KEY=base64:z+6J0ASj9w2w5mN/U41rfxIiPG3aRPa9bIN6fSYlYW4=
APP_DEBUG=false
APP_URL=https://airtrendmedia.com
APP_INSTALL=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_STACK=single

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miniworkers
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# JWT
JWT_SECRET=b08f1c62675d86c2fb9751dcd5561ab0c5a031d16b64610318076119ba508f5b
JWT_TTL=10080
JWT_REFRESH_TTL=20160

# Mail
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@miniworkers.app
MAIL_FROM_NAME="${APP_NAME}"

# Paystack (Naira/local currency accepted by Paystack)
# NOTE: Payment API keys are NOT set during installation.
# Set them from Admin Panel > Payment Keys after installation.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://airtrendmedia.com/wallet/deposit/verify
PAYSTACK_CURRENCY=NGN
PAYSTACK_WEBHOOK_URL=

# Defaults (managed from admin after install)
DEFAULT_CURRENCY=USD
ACTIVATION_FEE_USD=5
AFFILIATE_REWARD_USD=1.5
