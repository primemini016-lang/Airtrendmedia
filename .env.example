APP_NAME=Airtrendmedia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://airtrendmedia.com
APP_INSTALL=false
# Set APP_INSTALL=true only during the web installer, then it flips to false automatically.

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_STACK=single

# ─────────────────────────────────────────────────────────
# Database — Installation only requires DB + admin details.
# Default is MySQL for production. Use sqlite for local testing.
# ─────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=airtrendmedia
DB_USERNAME=root
DB_PASSWORD=
# For local SQLite testing:
# DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# JWT (auto-generated during install if empty)
JWT_SECRET=
JWT_TTL=10080
JWT_REFRESH_TTL=20160

# Mail — admin can choose auto email approval or manual verification
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@airtrendmedia.com
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────
# Paystack payment + dollar-to-currency settings
# Payment API keys are NOT set during installation — set them
# from Admin Panel > Payment Keys after installation.
# ─────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://airtrendmedia.com/wallet/deposit/verify
PAYSTACK_CURRENCY=NGN
PAYSTACK_WEBHOOK_URL=

# Defaults (managed from admin after install)
DEFAULT_CURRENCY=USD
ACTIVATION_FEE_USD=5
AFFILIATE_REWARD_USD=1.5
TRIAL_DAYS=3

# ─────────────────────────────────────────────────────────
# Airtrendmedia extended features (all optional / admin-managed)
# ─────────────────────────────────────────────────────────
# Monetization auto-enable thresholds
MONETIZATION_PAID_FOLLOWERS=500
MONETIZATION_ELIGIBLE_VIEWS=1000
MONETIZATION_REAL_ENGAGEMENT=1000
MONETIZATION_PAID_FOLLOWER_PRICE=5

# Blue verification badge
VERIFICATION_MONTHLY_FEE=5
VERIFICATION_VALIDITY_DAYS=30
VERIFICATION_AUTO_APPROVE=false

# Sponsored ads
SPONSORED_DEFAULT_CPC=0.02
SPONSORED_AUTO_APPROVE=false

# KYC
KYC_REQUIRED_FOR_WITHDRAWAL=true
KYC_AUTO_APPROVE=false

# Anti-cheat
ANTICHEAT_ENFORCE_ONE_PER_IP=true
ANTICHEAT_VIEW_THRESHOLD=10

# Push notifications (Firebase / OneSignal) — set from admin
PUSH_PROVIDER=none
FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# PWA
PWA_ENABLED=true
PWA_OFFLINE_ENABLED=true
PWA_NATIVE_APP_BEHAVIOR=true

# System updates (GitHub auto-update)
SYSTEM_UPDATE_REPO=primemini016-lang/Airtrendmedia
SYSTEM_UPDATE_BRANCH=main
