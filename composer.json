{
    "name": "miniworkers/microjob-marketplace",
    "type": "project",
    "description": "Modern microjob marketplace platform with paystack payments, affiliate rewards, and multi-currency support. Built for PHP 8.3 / 8.4 / 8.5.",
    "keywords": ["microjob", "marketplace", "miniworkers", "paystack", "affiliate", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "laravel/framework": "^11.0|^12.0",
        "tymon/jwt-auth": "^2.0",
        "intervention/image": "^3.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.33"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
